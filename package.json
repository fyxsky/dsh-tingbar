{
  "name": "dsh-tingbar",
  "version": "0.3.3",
  "description": "DeepSeek Harness 听说播放器插件（喜马拉雅 + 懒人听书双平台）：Host 端代理两个平台的搜索/专辑/目录/播放地址解析与扫码登录（免费曲直链，登录后解锁已购/VIP 内容），浏览器侧提供播放条与搜索/专辑/主播/我的面板与平台切换，并注册 ximalaya_play 模型工具",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "tingbar",
    "ting",
    "ximalaya",
    "lrts",
    "lanting",
    "audiobook",
    "podcast",
    "audio",
    "player"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyxsky/dsh-tingbar.git"
  },
  "bugs": {
    "url": "https://github.com/fyxsky/dsh-tingbar/issues"
  },
  "homepage": "https://github.com/fyxsky/dsh-tingbar#readme",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
